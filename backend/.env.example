# Database (SQLite)
DATABASE_URL=sqlite:///./app.db

# CORS: the frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Resume storage
RESUME_STORAGE_DIR=./storage/resumes
RESUME_MAX_BYTES=5242880

# Auth (Google SSO). Comma-separated attorney allowlist; these addresses also receive lead notifications.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
ATTORNEY_EMAILS=attorney@example.com

# Email. Leave SMTP_HOST empty to print emails to the console instead of sending.
# For Mailhog locally: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@example.com

# Public form: at most this many submissions per client address per window.
SUBMISSION_RATE_LIMIT=10
SUBMISSION_RATE_WINDOW_SECONDS=3600
# Confirmation emails sent to one address per day; more are skipped (the lead is still saved).
MAX_CONFIRMATIONS_PER_ADDRESS_PER_DAY=3
