# Database (SQLite)
DATABASE_URL=sqlite:///./app.db

# CORS: the frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Resume storage
RESUME_STORAGE_DIR=./storage/resumes
MAX_RESUME_SIZE_BYTES=5242880

# Auth (Google SSO). Comma-separated list of attorney emails allowed in.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
ATTORNEY_EMAILS=attorney@example.com

# Email (SMTP; e.g. Mailhog on localhost:1025 in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.com
