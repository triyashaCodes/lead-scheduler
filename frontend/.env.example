# Backend API base URL (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Google SSO client id (public value; must match the backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Largest resume the form accepts, in bytes (must match the backend RESUME_MAX_BYTES)
NEXT_PUBLIC_RESUME_MAX_BYTES=5242880
